# Exemplo Nginx — SPA + API Laravel (funeraria-baldan-nf)
#
# Produção: funerariabaldan.educraft.com.br (mesmo padrão gestorjob: /api → PHP-FPM).
# Certificado: certbot --nginx -d funerariabaldan.educraft.com.br

server {
    listen 80;
    listen [::]:80;
    server_name funerariabaldan.educraft.com.br;

    root /var/www/funeraria-baldan-nf/code/frontend/dist;
    index index.html;
    client_max_body_size 12M;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/funeraria-baldan-nf/code/frontend/dist;
        default_type "text/plain";
        allow all;
    }

    location ^~ /api {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/funeraria-baldan-nf/code/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/funeraria-baldan-nf/code/backend/public;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_read_timeout 300;
        fastcgi_hide_header X-Powered-By;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
