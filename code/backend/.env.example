APP_NAME="Funeraria Baldan NF"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Produção: URL pública da SPA (CORS). Obrigatório se APP_ENV=production.
FRONTEND_URL=http://localhost:5173

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=funeraria_baldan_nf
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Pack files: XML/DANFE em disco privado no MVP local; S3 na F6.
# FILESYSTEM_DISK=s3
# AWS_BUCKET=funeraria-baldan-nf
# AWS_DEFAULT_REGION=us-east-1
QUEUE_CONNECTION=database

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@funerariabaldan.local"
MAIL_FROM_NAME="${APP_NAME}"

# Focus NFe — empresa, A1 e CSC ficam no painel da Focus.
# Aqui só o token do ambiente + driver. Config da SPA manda o CNPJ na emissão.
FOCUSNFE_DRIVER=focus
FOCUSNFE_AMBIENTE=homologacao
FOCUSNFE_TOKEN_HOMOLOGACAO=
FOCUSNFE_TOKEN_PRODUCAO=
FOCUSNFE_TIMEOUT=30
FOCUSNFE_RETRY_ATTEMPTS=3
FOCUSNFE_CFOP_PADRAO=5102
FOCUSNFE_CSOSN_PADRAO=102
